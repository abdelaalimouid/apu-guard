    {
      "type": "timeseries",
      "title": "Alarms and sensor faults",
      "description": "1 = alarm (30 min anomalous). 0.5 = frozen pressure sensor (not counted as an anomaly).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "apu-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
