        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT report_time AS time, 'Failure ' || id || ': ' || label AS text FROM failures WHERE $__timeFilter(report_time)"
        }
      }
    ]
  },
  "panels": [
