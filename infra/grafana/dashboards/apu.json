    {
      "type": "timeseries",
      "title": "Panel pressure TP3 (bar)",
      "description": "Pressure of the pneumatic panel per 10-minute window. Red line: the 7 bar low-pressure alarm.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "apu-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "apu-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, tp3_min AS \"min\", tp3_mean AS \"mean\", tp3_max AS \"max\" FROM features WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Load share (duty rule: alarm above 0.5 over one hour)",
      "description": "Share of time the compressor pumps air. A leak makes it work more.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "apu-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "apu-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, load_share AS \"10 min\", avg(load_share) OVER (ORDER BY window_start ROWS BETWEEN 5 PRECEDING AND CURRENT ROW) AS \"1 h\" FROM features WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "id": 6
    },
