      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "apu-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, CASE WHEN alarm THEN 1 ELSE 0 END AS alarm, CASE WHEN sensor_fault THEN 0.5 ELSE 0 END AS \"frozen TP3\" FROM alarms WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
